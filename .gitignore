# Generic cruft. Project-specific ignores (the Django app's venv, database,
# generated secret key, etc.) live in portal/.gitignore.
node_modules/

# Secrets & local env (NEVER commit real values)
.env
.env.local
.env.*.local
serviceAccount*.json
*-service-account*.json
calendar-service-account*.json

# Logs & OS cruft
*.log
.DS_Store
Thumbs.db
