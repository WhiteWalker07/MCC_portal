# ── MCC Portal — environment ─────────────────────────────────────────────
# Copy to portal/.env for local dev (loaded by mccportal/settings.py's tiny
# loader — see _load_dotenv). On the lab PC, set these in a Windows service
# environment block instead (see HANDOVER.md's deployment section).
#
# Real environment variables always win over this file, so a Windows service
# definition can override it without editing .env.

# The public hostname of the portal once IT has provisioned it, e.g.
# mcc.iimsirmaur.ac.in. Leave unset for local dev (defaults to localhost).
PORTAL_HOST=localhost

# Set to 1 once the portal is actually served over HTTPS (behind Caddy on the
# lab PC). Leave unset/0 for local http://localhost dev — secure-only cookies
# would otherwise make sign-in impossible without TLS.
PORTAL_HTTPS=0

# Google OAuth 2.0 Web client (Google Cloud Console → Credentials).
# Redirect URI must EXACTLY match one on the OAuth client:
#   Local:   http://localhost:8000/accounts/google/login/callback/
#   Lab PC:  https://<PORTAL_HOST>/accounts/google/login/callback/
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxx

# Comma-separated Workspace domains allowed to sign in. This is only the
# fallback used before the first `seed_real_data` run — after that,
# PortalSettings.allowed_domains (editable in Django admin) is authoritative.
ALLOWED_DOMAINS=iimsirmaur.ac.in

# ── Optional integrations (auto-fallback to logging when unset) ────────────
# SMTP relay for outbound email. Unset -> emails are logged to the console/log
# file instead of sent (services/email.py) — safe for dev, useless in production.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=MCC Portal <mediacell@iimsirmaur.ac.in>

# Google Calendar service-account JSON (path to a file, or the JSON inline) —
# domain-wide delegation, per docs/PIC.md §3. Unset -> calendar calls are
# logged no-ops (services/calendar.py).
# CALENDAR_SERVICE_ACCOUNT_JSON=

# Where nightly backups are written (see `manage.py backup_db`). Point this at
# a second drive or network share — a backup on the same disk as the database
# protects against almost nothing.
# BACKUP_DIR=D:\mcc-backups
# BACKUP_KEEP_DAILY=14
# BACKUP_KEEP_WEEKLY=8

# Overrides the auto-generated key in data/secret_key.txt. Only set this if you
# need the same key across multiple machines; otherwise leave it to be
# generated once and persisted.
# DJANGO_SECRET_KEY=

# 1 for Django's debug mode (local dev only — never on the lab PC).
DJANGO_DEBUG=1
