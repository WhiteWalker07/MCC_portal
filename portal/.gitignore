# Virtual environment — recreate with: python -m venv .venv
.venv/

# The database, generated secret key, logs, and backups. None of this belongs
# in git — it's the live state of one specific deployment (docs/HANDOVER.md).
data/

# collectstatic output — regenerated by `manage.py collectstatic`.
staticfiles/

# Local environment overrides (see .env.example).
.env

# Python
__pycache__/
*.pyc

# Stray temp files (e.g. left behind by editor/preview tooling)
*.tmp.*

# Editor cruft
.vscode/
*.swp
